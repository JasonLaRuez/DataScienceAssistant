# Strip notebook outputs on commit (rule: notebooks are reviewed as text).
# The binding lives here so it is shared via the repository; the matching filter
# definition lives in .git/config, which is NOT cloned, so a fresh clone must run
# `nbstripout --install` once. See README.
*.ipynb filter=nbstripout
*.ipynb diff=ipynb

# Normalise line endings: LF in the repository, native in the working tree.
# Without this, core.autocrlf=true warns on every add.
* text=auto
